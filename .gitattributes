# Normalize line endings to LF in the repository regardless of platform.
# Matches Prettier's `endOfLine: lf`, so Windows checkouts stop producing
# whole-file diffs that bury real changes in review.
* text=auto eol=lf

# Shell scripts and git hooks must stay LF even on Windows or they will not
# execute under sh.
*.sh text eol=lf
.husky/* text eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
*.ktx2 binary
*.basis binary
*.mp4 binary
*.webm binary

# Lockfiles are generated; collapse them in diffs and reviews.
pnpm-lock.yaml linguist-generated=true -diff

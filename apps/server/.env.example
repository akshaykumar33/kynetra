# Copy to apps/server/.env.local for local development. Never commit .env.local.
NODE_ENV=development
PORT=4000
# PGlite folder (no Docker needed), or postgres://user:pass@host:5432/db
DATABASE_URL=.data/pglite
APP_ORIGIN=http://localhost:5173
# Password-less "sign in as" for local development. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=1
SEED_ON_START=1
# At least 32 characters. Required in production.
COOKIE_SECRET=
# Optional: real sign-in. Redirect URI is {APP_ORIGIN}/auth/google/callback (or /microsoft/).
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT=common
# Voice (LiveKit). Defaults match `npm run dev:voice` (livekit-server --dev). Required in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

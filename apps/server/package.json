    "@fastify/websocket": "^11.3.4",
    "@knovra/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.0.0",
    "livekit-server-sdk": "^2.19.1",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0"
  }

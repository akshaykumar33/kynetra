{
  "name": "@knovra/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/cli.ts seed"
  },

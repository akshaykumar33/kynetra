{
  "name": "knovra-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual office where remote and hybrid teams share one floor",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @knovra/web",
    "dev:server": "npm run dev -w @knovra/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run budget",
    "prepare": "simple-git-hooks",
    "db:migrate": "npm run db:migrate -w @knovra/server",
    "db:seed": "npm run db:seed -w @knovra/server",
    "load:presence": "node scripts/load-presence.mjs",
    "measure:fps": "node scripts/measure-fps.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
  }
}

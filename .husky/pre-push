#!/usr/bin/env sh
# Refuses direct pushes to main — prompts/starter_prompt.md §16.1
#
# WHY THIS EXISTS AS A HOOK
#
# §16.4 calls for server-side branch protection, which is the real boundary:
# it cannot be bypassed, and it applies to every clone and every CI actor.
# GitHub does not offer branch protection or rulesets for PRIVATE repositories
# on the Free plan — both APIs return 403 "Upgrade to GitHub Pro or make this
# repository public".
#
# So this hook is a STOPGAP, not the control. It is local, it is absent on a
# fresh clone until `pnpm install` runs, and anyone can delete it. It stops the
# accident, not an intent. Replace it with real branch protection as soon as
# the repository is public or on a paid plan, and keep it afterwards as a
# fast local failure.

remote_name="$1"
protected="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "refs/heads/$protected")
      if [ "$KYNETRA_ALLOW_MAIN_PUSH" = "1" ]; then
        echo "⚠  Pushing directly to $protected — KYNETRA_ALLOW_MAIN_PUSH is set."
        echo "   Record why in the next PR. This should be an outage, not a shortcut."
        exit 0
      fi

      echo ""
      echo "✖ Direct push to '$protected' on '$remote_name' refused."
      echo ""
      echo "  Every change reaches main through a pull request (§16.1),"
      echo "  including one-line docs fixes."
      echo ""
      echo "  If your work is sitting on local main, move it to a branch:"
      echo ""
      echo "    git branch <type>/<description>"
      echo "    git reset --hard origin/$protected"
      echo "    git switch <type>/<description>"
      echo "    git push -u origin <type>/<description>"
      echo "    gh pr create --fill --base $protected"
      echo ""
      echo "  Genuine emergency only: KYNETRA_ALLOW_MAIN_PUSH=1 git push ..."
      echo ""
      exit 1
      ;;
  esac
done

exit 0

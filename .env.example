# ==============================================================================
# Kynetra Platform — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development

# Core API Configuration
PORT=4000
HOST=0.0.0.0

# Persistence & Storage
POSTGRES_PORT=5433
DATABASE_URL=postgresql://kynetra_user:kynetra_password@localhost:5433/kynetra_world
REDIS_URL=redis://localhost:6379

# OpenTelemetry Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kynetra-platform

# Web Console Client
NEXT_PUBLIC_API_URL=http://localhost:4000

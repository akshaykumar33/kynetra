# ==============================================================================
# Dependencies & build output
# ==============================================================================
node_modules
.pnpm-store
dist
.next
out
build
coverage
.turbo
*.tsbuildinfo
*.log

# ==============================================================================
# Secrets & credentials — prompts/starter_prompt.md §17.4
#
# .gitignore prevents accidents; the secret scanner catches what slips past it.
# Both are required. Neither is sufficient alone.
# ==============================================================================

# Environment files. Every variant is ignored, then the documented templates
# are explicitly re-included — the previous list missed .env.staging and any
# other environment name nobody thought of in advance.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private keys and certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.asc
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub.bak

# Cloud and cluster credentials
.aws/
.gcloud/
gcp-service-account*.json
service-account*.json
kubeconfig
*.kubeconfig
.kube/config

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
crash.log

# Package registry auth
.npmrc
.yarnrc
!.npmrc.example

# ==============================================================================
# Data — never commit real or production data
# ==============================================================================
*.dump
*.rdb
*.sql.gz
*.mdb
dumps/
backups/

# ==============================================================================
# Editor & OS
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*~
